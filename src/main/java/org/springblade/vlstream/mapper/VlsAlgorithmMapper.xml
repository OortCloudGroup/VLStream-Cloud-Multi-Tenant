<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.vlstream.mapper.VlsAlgorithmMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="vlsAlgorithmResultMap" type="org.springblade.vlstream.pojo.vo.AlgorithmVO">
        <result column="repository_id" property="repositoryId"/>
        <result column="name" property="name"/>
        <result column="category" property="category"/>
        <result column="description" property="description"/>
        <result column="image_url" property="imageUrl"/>
        <result column="config_params" property="configParams"/>
        <result column="input_format" property="inputFormat"/>
        <result column="output_format" property="outputFormat"/>
        <result column="gpu_required" property="gpuRequired"/>
        <result column="is_system" property="isSystem"/>
    </resultMap>

    <select id="selectVlsAlgorithmPage" resultMap="vlsAlgorithmResultMap">
        SELECT a.*, r.name AS repository_name
        FROM vls_algorithm a
        LEFT JOIN vls_algorithm_repository r
            ON a.repository_id = r.id
            AND r.tenant_id = #{tenantId}
            AND r.is_deleted = 0
        WHERE a.is_deleted = 0
          AND a.tenant_id = #{tenantId}
        <if test="vlsAlgorithm.repositoryId != null">
            AND a.repository_id = #{vlsAlgorithm.repositoryId}
        </if>
        <if test="vlsAlgorithm.name != null and vlsAlgorithm.name != ''">
            AND a.name LIKE CONCAT('%', #{vlsAlgorithm.name}, '%')
        </if>
        <if test="vlsAlgorithm.category != null">
            AND a.category = #{vlsAlgorithm.category}
        </if>
        ORDER BY a.create_time DESC
    </select>

    <select id="exportVlsAlgorithm" resultType="org.springblade.vlstream.excel.VlsAlgorithmExcel">
        SELECT * FROM vls_algorithm ${ew.customSqlSegment}
    </select>

    <select id="selectByIdsAndTenantId" resultType="org.springblade.vlstream.pojo.entity.Algorithm">
        SELECT *
        FROM vls_algorithm
        WHERE is_deleted = 0
          AND tenant_id = #{tenantId}
          AND id IN
        <foreach collection="algorithmIds" item="algorithmId" open="(" separator="," close=")">
            #{algorithmId}
        </foreach>
    </select>

</mapper>
