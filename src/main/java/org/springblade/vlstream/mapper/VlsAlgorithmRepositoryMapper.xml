<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.vlstream.mapper.VlsAlgorithmRepositoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="vlsAlgorithmRepositoryResultMap" type="org.springblade.vlstream.pojo.entity.AlgorithmRepository">
        <result column="name" property="name"/>
        <result column="algorithm_count" property="algorithmCount"/>
        <result column="repository_type" property="repositoryType"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectVlsAlgorithmRepositoryPage" resultMap="vlsAlgorithmRepositoryResultMap">
        SELECT r.*,
               (SELECT COUNT(*)
                FROM vls_algorithm a
                WHERE a.repository_id = r.id
                  AND a.tenant_id = r.tenant_id
                  AND a.is_deleted = 0) AS algorithm_count
        FROM vls_algorithm_repository r
        WHERE r.is_deleted = 0
          AND r.tenant_id = #{tenantId}
        <if test="vlsAlgorithmRepository != null and vlsAlgorithmRepository.name != null and vlsAlgorithmRepository.name != ''">
            AND r.name LIKE CONCAT('%', #{vlsAlgorithmRepository.name}, '%')
        </if>
        <if test="vlsAlgorithmRepository != null and vlsAlgorithmRepository.repositoryType != null">
            AND r.repository_type = #{vlsAlgorithmRepository.repositoryType}
        </if>
        <if test="vlsAlgorithmRepository != null and vlsAlgorithmRepository.status != null">
            AND r.status = #{vlsAlgorithmRepository.status}
        </if>
        ORDER BY r.create_time DESC
    </select>

    <select id="exportVlsAlgorithmRepository" resultType="org.springblade.vlstream.excel.VlsAlgorithmRepositoryExcel">
        SELECT * FROM vls_algorithm_repository ${ew.customSqlSegment}
    </select>

</mapper>
